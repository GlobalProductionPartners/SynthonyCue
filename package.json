{
  "name": "synthony-cue",
  "version": "1.0.6",
  "description": "Synthony live show cue system",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "electron": "electron .",
    "dist": "electron-builder --mac --publish never",
    "release": "electron-builder --mac --publish never",
    "postinstall": "electron-builder install-app-deps",
    "test": "node --test"
  },
  "dependencies": {
    "artnet": "^1.1.0",
    "electron-updater": "^6.3.0",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "node-osc": "^9.1.0",
    "ws": "^8.18.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.synthony.cue",
    "productName": "Synthony Cue",
    "copyright": "Copyright \u00a9 2026 Synthony",
    "files": [
      "electron/**/*",
      "public/**/*",
      "server.js",
      "tc/**/*",
      "output/**/*",
      "video/**/*",
      "node_modules/**/*",
      "!node_modules/**/{CHANGELOG.md,README.md,readme.md,.editorconfig}",
      "!**/*.map",
      "!*.command",
      "!*.bat",
      "!*.xlsx",
      "!Screenshot*"
    ],
    "asarUnpack": [
      "public/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Synthony Cue ${version}",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "publish": {
      "provider": "github",
      "owner": "IWANTWOO",
      "repo": "synthony-cue"
    }
  }
}
