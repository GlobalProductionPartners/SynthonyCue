# Synthony Cue — server unit for Raspberry Pi OS (64-bit)
# Template: install-pi.sh substitutes __USER__, __DIR__ and __DATA_DIR__.
# Installed to /etc/systemd/system/synthony-cue.service

[Unit]
Description=Synthony Cue System
Documentation=https://github.com/IWANTWOO/synthony-cue
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
ExecStart=/usr/bin/env node server.js
Environment=NODE_ENV=production

# Keep config.json and data/ outside the checkout so a git pull cannot
# clobber a show, and so the service survives a redeploy.
Environment=SYNTHONY_DATA_DIR=__DATA_DIR__

Restart=always
RestartSec=3

# Allow binding port 80 as an unprivileged user, so displays can be reached
# as plain http://<hostname>/ with no port in the URL.
AmbientCapabilities=CAP_NET_BIND_SERVICE

StandardOutput=journal
StandardError=journal
SyslogIdentifier=synthony-cue

[Install]
WantedBy=multi-user.target
